# LLM Provider
# "mock"      — deterministic CTD fixtures (no API key required, used in tests)
# "anthropic" — production (Claude)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-7
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# API
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Drafting concurrency — bound to avoid LLM rate-limit thrash
MAX_CONCURRENT_SECTIONS=5
SECTION_DRAFT_TIMEOUT_S=120
